# ============================================================
# New-API 生产环境配置模板
# 复制此文件到目标机 /opt/new-api/.env 并修改实际值
# ============================================================

# ---- Docker 镜像标签（由部署脚本自动填写）----
IMAGE_TAG=latest

# ---- 主数据库 (MySQL) ----
# 业务数据：用户、渠道、Token、充值、配置等
SQL_DSN=root:your_mysql_password@tcp(10.0.1.14:3306)/new-api?parseTime=true

# ---- 日志数据库 (PostgreSQL) ----
# 请求日志、消费记录等。注意密码中 @ 需编码为 %40
LOG_SQL_DSN=postgresql://root:TokenTurbo%40PSQL1@10.0.0.15:5432/new-api

# ---- Redis ----
# 注意密码中 @ 需编码为 %40
REDIS_CONN_STRING=redis://:TokenTurbo%40Redis@10.0.1.6:6379

# ---- 多节点部署 (两台机器必须设置相同的值) ----
SESSION_SECRET=请生成一个随机字符串，两台机器必须一致
NODE_NAME=new-api-node-1

# ---- 同步与缓存 ----
SYNC_FREQUENCY=60
BATCH_UPDATE_INTERVAL=5
BATCH_UPDATE_ENABLED=true

# ---- 超时调优 ----
STREAMING_TIMEOUT=120
RELAY_TIMEOUT=0
